{
  "case_id": "PER-WL-USB-001",
  "case_name": "Peripheral Policy Tab Export Entry",
  "module": "peripheral",
  "flow": [
    {
      "name": "launch_app",
      "ref": "app.launch",
      "params": {
        "timeout_sec": 20
      }
    },
    {
      "name": "open_peripheral_manage",
      "ref": "navigation.open_page",
      "params": {
        "page_id": "peripheral-manage"
      }
    },
    {
      "name": "open_peripheral_policy_tab",
      "ref": "ui.click_text",
      "params": {
        "text": "黑白名单",
        "bundle_name": "{{bundle_name}}"
      }
    }
  ],
  "assertions": [
    {
      "name": "peripheral_policy_export_visible",
      "type": "assert_text_presence",
      "value": "导出名单",
      "level": "primary",
      "params": {
        "bundle_name": "{{bundle_name}}",
        "present": true,
        "timeout_ms": 2000,
        "interval_ms": 250
      }
    }
  ],
  "result_policy": {
    "allow_unknown": true,
    "stop_on_failure": true
  },
  "notes": [
    "当前版本通过“黑白名单”页维护设备策略，不再使用手工新增设备弹窗。",
    "覆盖边界：本用例只证明黑白名单页和“导出名单”入口可达，不证明默认 allow、设备指纹入库或单设备白名单策略已经生效。",
    "完整白名单场景还需要准备一台无历史指纹的真实 USB 设备，设置默认策略为 allow 后插入，并核对 desired_policy=allow、active_policy=none、present=true 及页面白名单记录。"
  ]
}
